<form version="1.1" script="MultiSelectHelper.js">
    <label>Health Overview</label>
    <fieldset submitButton="false">

        <input type="multiselect" token="host" searchWhenChanged="true">
            <label>Host</label>
            <choice value="*">All</choice>
            <search fieldForValue="host" fieldForLabel="host">
                <query>
                <![CDATA[ index=_internal sourcetype=mscs:*:log | stats count by host|table host ]]>
                </query>
            </search>
            <prefix> (</prefix>
            <suffix>) </suffix>
            <valuePrefix>host="</valuePrefix>
            <valueSuffix>"</valueSuffix>
            <delimiter> OR </delimiter>
            <default>All</default>
            <fieldForLabel>host</fieldForLabel>
            <fieldForValue>host</fieldForValue>
        </input>

        <input type="multiselect" token="modinput_logs" searchWhenChanged="true">
            <label>Input Type</label>
            <choice value="sourcetype=mscs:azure:eventhub:log OR sourcetype=mscs:storage:table:log OR sourcetype=mscs:storage:blob:log OR sourcetype=mscs:azure:audit:log OR sourcetype=mscs:azure:resource:log OR sourcetype=mscs:metrics:log OR sourcetype=mscs:kql:log OR sourcetype=mscs:azure:consumption:log">All</choice>
            <choice value="sourcetype=mscs:azure:eventhub:log">Event Hub</choice>
            <choice value="sourcetype=mscs:storage:table:log">Storage Table</choice>
            <choice value="sourcetype=mscs:storage:blob:log">Storage Blob</choice>
            <choice value="sourcetype=mscs:azure:audit:log">Audit</choice>
            <choice value="sourcetype=mscs:azure:resource:log">Resource</choice>
            <choice value="sourcetype=mscs:metrics:log">Metrics</choice>
            <choice value="sourcetype=mscs:kql:log">KQL</choice>
            <choice value="sourcetype=mscs:azure:consumption:log">Consumption (Billing)</choice>
            <prefix> (</prefix>
            <suffix>) </suffix>
            <delimiter> OR </delimiter>
            <default>All</default>
        </input>

        <input type="multiselect" token="modinput_names" searchWhenChanged="true" dependsOn="modinput_logs">
            <label>Input Name</label>
            <choice value="*">All</choice>
            <search fieldForValue="modinput_name" fieldForLabel="modinput_name">
                <query><![CDATA[
                index=_internal $modinput_logs$
                | eval modinput_name=if(isnull(stanza_name), datainput, stanza_name)
                | stats count by modinput_name
                | table modinput_name
                | sort modinput_name
                ]]></query>
            </search>
            <prefix> (</prefix>
            <suffix>) </suffix>
            <delimiter>, </delimiter>
            <default>All</default>
            <fieldForLabel>modinput_name</fieldForLabel>
            <fieldForValue>modinput_name</fieldForValue>
        </input>

        <input type="text" token="key_word" searchWhenChanged="true">
            <label>Keyword</label>
            <prefix> "</prefix>
            <suffix>"</suffix>
            <default></default>
        </input>

        <input type="time" searchWhenChanged="true">
            <label>Time Range</label>
            <default>
                <earliest>-1d</earliest>
                <latest>now</latest>
            </default>
        </input>

    </fieldset>

    <search id="baseErrorSearch">
        <query>
            <![CDATA[
                index=_internal $host$ $modinput_logs$ $key_word$ (level=ERROR OR log_level=ERROR)
                | eval modinput_name = if(isnull(stanza_name), datainput, stanza_name)
                | search modinput_name IN $modinput_names$
                | table count by _time, message, host, sourcetype, modinput_name
                | eval error_count=1
            ]]>
        </query>
        <earliest>$earliest$</earliest>
        <latest>$latest$</latest>
    </search>

    <search id="baseWarningSearch">
        <query>
            <![CDATA[
                index=_internal $host$ $modinput_logs$ $key_word$ (level=WARNING OR log_level=WARNING)
                | eval modinput_name = if(isnull(stanza_name), datainput, stanza_name)
                | search modinput_name IN $modinput_names$
                | table count by _time, message, host, sourcetype, modinput_name
                | eval warning_count=1
            ]]>
        </query>
        <earliest>$earliest$</earliest>
        <latest>$latest$</latest>
    </search>

    <row>
        <panel>
            <title>Errors / Warnings - To get a detailed list, click on the error/warning count</title>
            <single>
                <title>Total</title>
                <search base="baseErrorSearch">
                    <query>
                        | stats count, sum(error_count) as error_count
                        | eval error_count=if(isnotnull(error_count), error_count, 0)
                        | fields error_count
                        | rename error_count as count
                    </query>
                </search>
                <option name="useColors">1</option>
                <option name="colorBy">value</option>
                <option name="colorMode">block</option>
                <option name="rangeColors">["0x65a637","0xFF0000"]</option>
                <option name="rangeValues">[0]</option>
                <option name="field">count</option>
                <option name="underLabel">Errors</option>
                <drilldown>
                    <link target="_blank">
                        error_details
                    </link>
                </drilldown>
            </single>
            <single>
                <title>Total</title>
                <search base="baseWarningSearch">
                    <query>
                        | stats count, sum(warning_count) as warning_count
                        | eval warning_count=if(isnotnull(warning_count), warning_count, 0)
                        | fields warning_count
                        | rename warning_count as count
                    </query>
                </search>
                <drilldown>
                    <link target="_blank">
                        warning_details
                    </link>
                </drilldown>
                <option name="useColors">1</option>
                <option name="colorBy">value</option>
                <option name="colorMode">block</option>
                <option name="rangeColors">["0x65a637","0xff8000"]</option>
                <option name="rangeValues">[0]</option>
                <option name="field">count</option>
                <option name="underLabel">Warnings</option>
            </single>
        </panel>
    </row>

    <row>
        <panel>
            <chart>
                <title>Errors by Input Types Over Time</title>
                <search base="baseErrorSearch">
                    <query>
                        <![CDATA[
                            | rename error_count as count
                            | lookup mscs_log_sourcetype_modinput_lookup sourcetype OUTPUT modinput
                            | timechart sum(count) by modinput
                        ]]>
                    </query>
                    <earliest>$earliest$</earliest>
                    <latest>$latest$</latest>
                </search>
                <option name="charting.axisLabelsX.majorLabelStyle.overflowMode">ellipsisNone</option>
                <option name="charting.axisLabelsX.majorLabelStyle.rotation">0</option>
                <option name="charting.axisTitleX.visibility">collapsed</option>
                <option name="charting.axisTitleY.text">Errors (count)</option>
                <option name="charting.axisTitleY.visibility">visible</option>
                <option name="charting.axisTitleY2.visibility">visible</option>
                <option name="charting.axisX.scale">linear</option>
                <option name="charting.axisY.scale">linear</option>
                <option name="charting.axisY2.enabled">0</option>
                <option name="charting.axisY2.scale">inherit</option>
                <option name="charting.chart">column</option>
                <option name="charting.chart.nullValueMode">connect</option>
                <option name="charting.chart.showDataLabels">none</option>
                <option name="charting.chart.sliceCollapsingThreshold">0.01</option>
                <option name="charting.chart.stackMode">stacked</option>
                <option name="charting.chart.style">shiny</option>
                <option name="charting.drilldown">all</option>
                <option name="charting.layout.splitSeries">0</option>
                <option name="charting.layout.splitSeries.allowIndependentYRanges">0</option>
                <option name="charting.legend.labelStyle.overflowMode">ellipsisMiddle</option>
                <option name="charting.legend.placement">right</option>
            </chart>
        </panel>
    </row>

    <row>
        <panel>
            <chart>
                <title>Errors by Hosts Over Time</title>
                <search base="baseErrorSearch">
                    <query>
                        <![CDATA[
                            | rename error_count as count
                            | timechart sum(count) by host
                        ]]>
                    </query>
                    <earliest>$earliest$</earliest>
                    <latest>$latest$</latest>
                </search>
                <option name="charting.axisLabelsX.majorLabelStyle.overflowMode">ellipsisNone</option>
                <option name="charting.axisLabelsX.majorLabelStyle.rotation">0</option>
                <option name="charting.axisTitleX.visibility">collapsed</option>
                <option name="charting.axisTitleY.text">Errors (count)</option>
                <option name="charting.axisTitleY.visibility">visible</option>
                <option name="charting.axisTitleY2.visibility">visible</option>
                <option name="charting.axisX.scale">linear</option>
                <option name="charting.axisY.scale">linear</option>
                <option name="charting.axisY2.enabled">0</option>
                <option name="charting.axisY2.scale">inherit</option>
                <option name="charting.chart">column</option>
                <option name="charting.chart.nullValueMode">connect</option>
                <option name="charting.chart.showDataLabels">none</option>
                <option name="charting.chart.sliceCollapsingThreshold">0.01</option>
                <option name="charting.chart.stackMode">stacked</option>
                <option name="charting.chart.style">shiny</option>
                <option name="charting.drilldown">all</option>
                <option name="charting.layout.splitSeries">0</option>
                <option name="charting.layout.splitSeries.allowIndependentYRanges">0</option>
                <option name="charting.legend.labelStyle.overflowMode">ellipsisMiddle</option>
                <option name="charting.legend.placement">right</option>
            </chart>
        </panel>
    </row>

    <row>
        <panel>
            <chart>
                <title>Errors by Input Names Over Time</title>
                <search base="baseErrorSearch">
                    <query>
                        <![CDATA[
                            | rename error_count as count
                            | timechart sum(count) by modinput_name
                        ]]>
                    </query>
                    <earliest>$earliest$</earliest>
                    <latest>$latest$</latest>
                </search>
                <option name="charting.axisLabelsX.majorLabelStyle.overflowMode">ellipsisNone</option>
                <option name="charting.axisLabelsX.majorLabelStyle.rotation">0</option>
                <option name="charting.axisTitleX.visibility">collapsed</option>
                <option name="charting.axisTitleY.text">Errors (count)</option>
                <option name="charting.axisTitleY.visibility">visible</option>
                <option name="charting.axisTitleY2.visibility">visible</option>
                <option name="charting.axisX.scale">linear</option>
                <option name="charting.axisY.scale">linear</option>
                <option name="charting.axisY2.enabled">0</option>
                <option name="charting.axisY2.scale">inherit</option>
                <option name="charting.chart">column</option>
                <option name="charting.chart.nullValueMode">connect</option>
                <option name="charting.chart.showDataLabels">none</option>
                <option name="charting.chart.sliceCollapsingThreshold">0.01</option>
                <option name="charting.chart.stackMode">stacked</option>
                <option name="charting.chart.style">shiny</option>
                <option name="charting.drilldown">all</option>
                <option name="charting.layout.splitSeries">0</option>
                <option name="charting.layout.splitSeries.allowIndependentYRanges">0</option>
                <option name="charting.legend.labelStyle.overflowMode">ellipsisMiddle</option>
                <option name="charting.legend.placement">right</option>
            </chart>
        </panel>
    </row>

</form>
<!--
// jscpd:ignore-end
-->
